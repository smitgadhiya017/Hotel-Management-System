# Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to GitHub!

# Supabase PostgreSQL Connection String (Session / Transaction Pooler on port 6543 recommended)
# Example format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@[HOST]:[PORT]/postgres

# Server Port (optional, defaults to 10000 on Render or 3001 locally)
PORT=10000

# Frontend API URL (for production deployments like Vercel connecting to Render backend)
VITE_API_URL=
